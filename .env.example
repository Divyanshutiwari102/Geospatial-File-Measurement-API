# Upload settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=52428800  # 50 MB in bytes

# Database settings
# For SQLite (default):
DATABASE_URL=sqlite:///./geospatial.db
# For PostgreSQL (uncomment and adjust):
# DATABASE_URL=postgresql://user:password@host:port/db

# Measurement settings (optional)
DEFAULT_AREA_UNIT=square_meters
DEFAULT_LENGTH_UNIT=meters